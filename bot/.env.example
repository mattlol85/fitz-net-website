# Bot Server Environment Configuration
# Copy this to .env and adjust values.
# Minecraft server is external to this repo.

# Bot server port
BOT_SERVER_PORT=3002

# External Minecraft server connection
MC_SERVER_HOST=localhost
MC_SERVER_PORT=25565
MC_VERSION=1.21.11
# Auth mode: offline (for offline-mode servers) or microsoft (for online-mode servers)
MC_AUTH=offline

# API key for bot server authentication
BOT_API_KEY=dev-api-key
