# Fitz-Net API Configuration
# Copy this file to .env and update with your API base URL

# Development: Use /api (proxied by Vite to avoid CORS issues)
# The Vite dev server will proxy /api/* to http://fitznet.doomdns.org:8585
VITE_API_BASE_URL=/api

# Production: Use the full backend URL if CORS is configured
# VITE_API_BASE_URL=http://fitznet.doomdns.org:8585

